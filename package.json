{
  "name": "eth-lecture-copilot",
  "private": true,
  "description": "Chrome extension tests (Jest); extension itself has no build step",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "check:api": "node scripts/check-api-params.mjs",
    "update:catalog": "node scripts/update-catalog.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/lib/transformers/",
      "/lib/katex/",
      "/lib/pdfjs/"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "yaml": "^2.9.0"
  }
}
